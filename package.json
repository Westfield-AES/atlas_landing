    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
